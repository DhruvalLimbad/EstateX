<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="EstateX.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - EstateX</title>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: #fcfcfd; color: #111827; }

        /* Master Navbar */
        .site-header {
            background: #ffffff;
            border-bottom: 1px solid #edf2f7;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .nav-wrapper {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand-logo {
            font-size: 20px;
            font-weight: 800;
            color: #0052cc;
            text-decoration: none;
            letter-spacing: -0.4px;
        }

        /* Nav links */
        .nav-links-list {
            display: flex;
            list-style: none;
            gap: 28px;
            align-items: center;
        }
        .nav-link-item {
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            color: #4b5563;
            transition: color 0.15s ease;
        }
        .nav-link-item:hover, .nav-link-item.active {
            color: #0052cc;
        }

        /* Right Actions */
        .nav-right-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .nav-icon-btn {
            background: none;
            border: none;
            font-size: 16px;
            color: #4b5563;
            cursor: pointer;
            text-decoration: none;
            padding: 4px;
            display: flex;
            align-items: center;
        }
        .nav-icon-btn:hover {
            color: #0052cc;
        }

        /* Unauthenticated buttons */
        .btn-auth-outline {
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 600;
            color: #1f2937;
            background: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            text-decoration: none;
        }
        .btn-auth-solid {
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff !important;
            background: #0052cc;
            border: 1px solid #0052cc;
            border-radius: 6px;
            text-decoration: none;
        }

        .main-content-wrap {
            max-width: 1280px;
            margin: 0 auto;
            padding: 24px;
        }
        .nav-right-actions {
    display: flex;
    align-items: center;
    gap: 16px;
}

.nav-icon-action {
    background: transparent;
    border: none;
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border-radius: 6px;
    transition: background-color 0.15s ease;
}

.nav-icon-action:hover {
    background-color: #eff6ff;
}

.nav-icon-action svg {
    display: block;
}
/* Navigation Links Styling */
.nav-links-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 24px;
}

.nav-link-item {
    font-size: 14px;
    font-weight: 500;
    color: #4b5563; /* Default inactive gray */
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
}

.nav-link-item:hover {
    color: #2563eb;
    background-color: #eff6ff;
}

/* Active Page Blue Color */
.nav-link-item.active {
    color: #2563eb !important;
    font-weight: 700 !important;
    background-color: #eff6ff !important;
}
.nav-links-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
}

.nav-link-item {
    font-size: 14px;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 6px;
    transition: all 0.15s ease-in-out;
}

.nav-link-item:hover {
    color: #2563eb;
    background-color: #eff6ff;
}

/* Active Highlight: applies to Home, Properties, Sign In, etc. */
.nav-link-item.active {
    color: #2563eb !important;
    font-weight: 700 !important;
    background-color: #eff6ff !important;
}

/* Guest Register Blue Button */
.btn-guest-register {
    background-color: #2563eb;
    color: #ffffff;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s ease;
}

.btn-guest-register:hover {
    background-color: #1d4ed8;
    color: #ffffff;
}
    </style>
</head>
<body>
    <form id="form1" runat="server">
       <header class="site-header">
    <div class="nav-wrapper">
        <a href="<%= ResolveUrl("~/Default.aspx") %>" class="brand-logo">EstateX</a>

        <!-- 1. Guest / Logged-Out Navbar -->
        <!-- 1. Guest / Public User Navbar -->
<asp:PlaceHolder ID="phGuestNav" runat="server">
    <ul class="nav-links-list">
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.Equals("~/Default.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>' 
               href="<%= ResolveUrl("~/Default.aspx") %>">Home</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("PropertyList.aspx", StringComparison.OrdinalIgnoreCase) >= 0 || Request.AppRelativeCurrentExecutionFilePath.IndexOf("PropertyDetails.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/PropertyList.aspx") %>">Properties</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("About.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/About.aspx") %>">About</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Contact.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a>
        </li>
    </ul>

    <!-- Guest Actions: Sign In / Register -->
    <div class="nav-right-actions">
        <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Login.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
           href="<%= ResolveUrl("~/Login.aspx") %>">Sign In</a>
        <a href="<%= ResolveUrl("~/Register.aspx") %>" class="btn-guest-register">Register</a>
    </div>
</asp:PlaceHolder>

       <!-- 2. Logged-In User Navbar -->
<asp:PlaceHolder ID="phUserNav" runat="server" Visible="false">
    <ul class="nav-links-list">
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.Equals("~/Default.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>' 
               href="<%= ResolveUrl("~/Default.aspx") %>">Home</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("PropertyList.aspx", StringComparison.OrdinalIgnoreCase) >= 0 || Request.AppRelativeCurrentExecutionFilePath.IndexOf("PropertyDetails.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/PropertyList.aspx") %>">Properties</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Wishlist.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/Wishlist.aspx") %>">Wishlist</a>
        </li>
        <li>
            <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("MyVisits.aspx", StringComparison.OrdinalIgnoreCase) >= 0 || Request.AppRelativeCurrentExecutionFilePath.IndexOf("ScheduleVisit.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
               href="<%= ResolveUrl("~/MyVisits.aspx") %>">My Visits</a>
        </li>
          <li>
      <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("About.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
         href="<%= ResolveUrl("~/About.aspx") %>">About</a>
  </li>
  <li>
      <a class='nav-link-item <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Contact.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
         href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a>
  </li>
    </ul>

    <!-- 3 Action Icons: Notification, Profile, Logout -->
    <div class="nav-right-actions">
        <!-- Notification Bell -->
        <!-- 1. Notification Bell Icon Linked to Page -->
<a href="<%= ResolveUrl("~/Notifications.aspx") %>" 
   class='nav-icon-action <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Notifications.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
   title="Notifications">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 16H6c1-1.5 2-3 2-6a4 4 0 0 1 8 0c0 3 1 4.5 2 6z"></path>
        <path d="M12 2v2"></path>
        <circle cx="12" cy="19.5" r="0.75" fill="#2563eb"></circle>
    </svg>
</a>

        <!-- Profile Circle -->
        <a href="<%= ResolveUrl("~/Profile.aspx") %>" 
   class='nav-icon-action <%= Request.AppRelativeCurrentExecutionFilePath.IndexOf("Profile.aspx", StringComparison.OrdinalIgnoreCase) >= 0 ? "active" : "" %>' 
   title="Profile">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <circle cx="12" cy="10" r="2.2" fill="#2563eb"></circle>
        <path d="M7.8 17.2a4.5 4.5 0 0 1 8.4 0"></path>
    </svg>
</a>

        <!-- Logout Exit -->
        <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="nav-icon-action" CausesValidation="false" ToolTip="Logout">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 4H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6"></path>
                <path d="M11 12h10"></path>
                <path d="M17 8l4 4-4 4"></path>
            </svg>
        </asp:LinkButton>
    </div>
</asp:PlaceHolder></header>

        <main class="main-content-wrap">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>
    </form>
</body>
</html>